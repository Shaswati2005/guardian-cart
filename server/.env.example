# PayPal SANDBOX REST app (developer.paypal.com → Apps & Credentials → Sandbox)
# Enable "Save payment methods" (Vault) on the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's Webhooks section (used for signature verification)
PAYPAL_WEBHOOK_ID=

# Claude (Anthropic): an API key from console.anthropic.com -> API Keys (starts with sk-ant-).
# Check it with: npm run check:ai
ANTHROPIC_API_KEY=
# Optional: a different Claude model (default claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# Channel3 product search (trychannel3.com) — optional; falls back to curated catalog
CHANNEL3_API_KEY=

# Email alerts via Resend (resend.com) — optional; alerts stay in-app without it
RESEND_API_KEY=
ALERT_FROM_EMAIL=
CAREGIVER_EMAIL=

# Signs approval links and persona sessions — set to a long random string (16+ chars).
# Required in production (the server refuses to start without it).
APP_SECRET=

# PIN for Sarah's dashboard (approve, refund, change rules). 6+ characters. Required in production.
CAREGIVER_PIN=

PORT=5000
PUBLIC_BASE_URL=http://localhost:5000

# Where the browser app lives (dev: Vite on 3000; prod: same origin "/")
CLIENT_URL=http://localhost:3000

# Optional
# PAYPAL_VAULT_ID=        # reuse a mandate after a restart on hosts whose disk is wiped (logged after Connect PayPal)
# DATA_DIR=               # where db.json lives (point at a persistent disk if you have one)
# AI_DAILY_LIMIT=600      # max AI requests per day across all visitors (protects the Claude API spend)
# TRUST_PROXY=1           # trust X-Forwarded-For from one proxy hop (set automatically on Render)
